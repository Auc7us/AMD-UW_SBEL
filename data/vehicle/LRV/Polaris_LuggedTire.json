// Lugged rigid-mesh tyre, replacing Polaris_TMeasyTire.json for deformable (SCM) terrain.
//
// TWO reasons this is a RigidTire and not TMeasy:
//
// 1. TMeasy is a FORCE ELEMENT with no collision geometry, so SCM's ray casts hit
//    nothing at the wheel: the tyre rides the deformed surface (GetHeight returns it)
//    but never cuts a rut and never earns Bekker-Wong sinkage resistance. See the
//    "TMeasy tires carry NO collision geometry" notes in RobotRig.cpp.
// 2. Bolting a collision shape onto a TMeasy wheel would double-count support --
//    TMeasy pushing off terrain height AND SCM pushing off the new shape. One contact
//    model per wheel, or the rover rides high on soil it is being held up by twice.
//
// The collision geometry is a TRIANGLE MESH, not a cylinder plus box lugs, because
// Chrono's SCM HIP ray-cast backend consumes only ChCollisionShape::TRIANGLEMESH
// (AppendLocalMesh in SCMTerrainRaycastGpu.cpp `continue`s past every other type).
// Same shape either way; only this representation can ever reach the GPU.
//
// Geometry from tools/make_lugged_wheel.py: 10 rectangular grousers across the full
// tread, lug tips at 0.4089 m so the effective rolling radius still matches the
// TMeasy tyre this replaces, barrel recessed to 0.3889 m. 202 verts / 360 triangles.
{
  "Name": "Polaris Lugged Mesh Tire",
  "Type": "Tire",
  "Template": "RigidTire",

  "Radius": 0.4089,
  "Width": 0.30,
  "Mass": 15.1,
  "Inertia": [ 0.64, 1.34, 0.64 ],

  "Contact Material": {
    // Friction matches the ground material used everywhere else in this scene (0.9).
    // Restitution 0: SMC penalty contact plus a bouncy tyre is how the trailer got
    // launched before, and regolith does not bounce.
    "Coefficient of Friction": 0.9,
    "Coefficient of Restitution": 0.0,

    "Properties": {
      "Young Modulus": 2e7,
      "Poisson Ratio": 0.3
    },

    "Coefficients": {
      "Normal Stiffness": 172246,
      "Normal Damping": 352.487,
      "Tangential Stiffness": 172246,
      "Tangential Damping": 352.487
    }
  },

  // Sweep sphere 5 mm: a swept-sphere layer keeps thin lug faces from tunnelling and
  // is what Polaris_RigidMeshTire.json already used on this vehicle.
  "Contact Mesh": {
    "Mesh Filename": "LRV/meshes/Polaris_lugged_wheel_collision.obj",
    "Sweep Sphere Radius": 0.005
  },

  "Visualization": {
    "Mesh Filename Left": "LRV/meshes/Polaris_tire.obj",
    "Mesh Filename Right": "LRV/meshes/Polaris_tire.obj"
  }
}
