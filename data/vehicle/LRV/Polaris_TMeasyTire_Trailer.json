// TMeasy is parameterised around a NOMINAL vertical load, and its vertical spring
// stiffness follows from that load. This tire previously specified
// "Load Index": 108, i.e. a nominal load of ~9800 N -- a 1-tonne truck tire.
// At lunar gravity (1.62 m/s^2) a measured tractor wheel here carries ~480 N and a
// trailer wheel ~107 N, so the tire was built for roughly 20x (tractor) and 90x
// (trailer) the load it actually bears. That makes it enormously stiff for its
// duty: a small deflection error becomes a huge force, and wheels were spiking to
// 2000-4000 N against a ~100 N settled load and launching the trailer.
//
// Load Index is therefore removed so the reader falls through to
// "Maximum Bearing Capacity [N]", which parameterises the tire from a nominal load
// in newtons directly. Note that branch selects the truck vs passenger-car
// parameter family from "Name" (lowercase "truck"), not "Vehicle Type", so this
// tire deliberately gets the passenger-car family -- appropriate for a light rover.
//
// Re-measure with the settled-load lines the sim prints at startup if the vehicle
// mass, the trailer load, or gravity changes.
{
  "Name": "Polaris TMeasy Tire (trailer)",
  "Type": "Tire",
  "Template": "TMeasyTire",

  // ------------------------------------------------
  // Tire design (REQUIRED)

  "Design": {
    "Unloaded Radius [m]": 0.4089,
    "Mass [kg]": 15.1,
    "Inertia [kg.m2]": [ 0.64, 1.34, 0.64 ],
    "Width [m]": 0.30,
    "Rim Radius [m]": 0.1778
  },

  "Coefficient of Friction": 0.75,

  "Rolling Resistance Coefficient": 0.0308346,
  // ------------------------------------------------
  // Vehicle type.
  // Required only if tire specified with "load index" or "bearing capacity".
  // Must be one of "Truck" or "Passenger"

  "Vehicle Type": "Truck",


  // ------------------------------------------------
  // Nominal vertical load [N]. Measured trailer wheel load is ~107 N empty; 150 N leaves headroom for a bed full of rocks.

  "Maximum Bearing Capacity [N]": 150.0,

  // ------------------------------------------------
  // Visualization mesh (OPTIONAL)

  "Visualization": {
    "Mesh Filename Left": "LRV/meshes/LRVtire_red_m.obj",
    "Mesh Filename Right": "LRV/meshes/LRVtire_red_m.obj"
  }

}
